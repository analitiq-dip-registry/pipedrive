{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "connector_id": "12e25261-b29b-4471-aecb-48ebaa785f44",
  "kind": "api",
  "display_name": "Pipedrive",
  "description": "Sales CRM and pipeline management platform for tracking deals, contacts, and sales activities",
  "documentation_url": "https://developers.pipedrive.com/docs/api/v1",
  "version": "1.1.0",
  "default_transport": "api",
  "transports": {
    "auth": {
      "transport_type": "http",
      "base_url": "https://oauth.pipedrive.com",
      "headers": {
        "Accept": "application/json",
        "Authorization": {
          "function": "basic_auth",
          "input": {
            "username": { "ref": "connection.parameters.client_id" },
            "password": { "ref": "secrets.client_secret" }
          }
        }
      }
    },
    "discovery": {
      "transport_type": "http",
      "base_url": "https://api.pipedrive.com",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Authorization": { "template": "Bearer ${auth.access_token}" }
      }
    },
    "api": {
      "transport_type": "http",
      "base_url": "https://${connection.discovered.api_domain}.pipedrive.com/api/v1",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Authorization": { "template": "Bearer ${auth.access_token}" }
      },
      "timeout_seconds": 30,
      "rate_limit": {
        "max_requests": 80,
        "time_window_seconds": 2
      }
    }
  },
  "auth": {
    "type": "oauth2_authorization_code",
    "authorize": {
      "transport_ref": "auth",
      "method": "GET",
      "path": "/oauth/authorize"
    },
    "token_exchange": {
      "transport_ref": "auth",
      "method": "POST",
      "path": "/oauth/token",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": {
        "template": "grant_type=authorization_code&code=${runtime.oauth.code}&redirect_uri=${runtime.oauth.redirect_uri}"
      }
    },
    "refresh": {
      "transport_ref": "auth",
      "method": "POST",
      "path": "/oauth/token",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": {
        "template": "grant_type=refresh_token&refresh_token=${auth.refresh_token}"
      }
    }
  },
  "connection_contract": {
    "inputs": {
      "client_id": {
        "source": "platform",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true
      },
      "client_secret": {
        "source": "platform",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true
      }
    },
    "post_auth_outputs": {
      "api_domain": {
        "mode": "auto_discovery",
        "storage": "connection.discovered",
        "type": "string",
        "value_path": "data.company_domain",
        "discovery_request": {
          "transport_ref": "discovery",
          "method": "GET",
          "path": "/v1/users/me"
        }
      }
    },
    "required_for_activation": [
      "connection.discovered.api_domain"
    ]
  }
}
